[
  {
    "key": "requirement_discovery",
    "name": "需求发现模板",
    "description": "访谈导入→转写/解析→事实抽取→审核→需求确认（任务书 §8 第一批模板①；执行段引用 published 调研技能，审核段复用人工审批节点——AI 产出一律落草稿待人工确认）。",
    "dag": {
      "nodes": [
        {
          "key": "intake",
          "type": "human_approval",
          "depends_on": [],
          "capability": "workbench.write",
          "expires_minutes": 60
        },
        {
          "key": "analyze",
          "type": "skill",
          "ref": "research-brief@1",
          "depends_on": ["intake"],
          "output": "research_brief",
          "max_retries": 1,
          "timeout_seconds": 3600,
          "failure_class": "retryable",
          "input_schema": { "type": "object" },
          "output_schema": { "type": "object" },
          "params": {
            "project_id": "{{project_id}}",
            "objective": "整理本项目访谈纪要与调研资料，产出岗位调研摘要和待确认问题清单；事实与需求结论交下游人工审核，不自行定稿。"
          }
        },
        {
          "key": "fact_review",
          "type": "human_approval",
          "depends_on": ["analyze"],
          "capability": "workbench.write",
          "expires_minutes": 1440
        }
      ]
    }
  },
  {
    "key": "plan_execution",
    "name": "方案实施模板",
    "description": "读取需求/本体→方案生成→审批→任务整理→计划发布（任务书 §8 第一批模板②；方案骨架经 solutions.create 生成草稿，人工修订后才可导出）。",
    "dag": {
      "nodes": [
        {
          "key": "plan_review",
          "type": "human_approval",
          "depends_on": [],
          "capability": "workbench.write",
          "expires_minutes": 60
        },
        {
          "key": "solution_draft",
          "type": "call",
          "ref": "solutions.create",
          "depends_on": ["plan_review"],
          "output": "solution_draft",
          "max_retries": 0,
          "timeout_seconds": 600,
          "failure_class": "fatal",
          "params": {
            "name": "交付方案草稿（模板生成，人工修订后生效）",
            "design_markdown": "# 交付方案草稿（待人工修订）\n\n## 方案设想\n- 待补：按交付方案条目概述解决思路与预期收益\n\n## 实施路径\n- 待补：阶段与里程碑",
            "deliverables": "- 待补：核心交付物清单",
            "acceptance_criteria": "- 待补：验收标准",
            "data_systems": "- 待补：系统与部署约束",
            "schedule": "- 待补：阶段与里程碑",
            "risks_dependencies": "- 待补：风险与依赖"
          }
        },
        {
          "key": "task_setup",
          "type": "skill",
          "ref": "workbench-record-management@1",
          "depends_on": ["solution_draft"],
          "output": "task_plan",
          "max_retries": 1,
          "timeout_seconds": 1800,
          "failure_class": "retryable",
          "input_schema": { "type": "object" },
          "output_schema": { "type": "object" },
          "params": {
            "project_id": "{{project_id}}",
            "objective": "按已确认方案条目整理实施计划与任务分解建议；任务创建仍走人工确认通道，不代建任务。"
          }
        },
        {
          "key": "plan_acceptance",
          "type": "human_approval",
          "depends_on": ["task_setup"],
          "capability": "workbench.write",
          "expires_minutes": 1440
        }
      ]
    }
  },
  {
    "key": "automated_delivery",
    "name": "自动化交付模板",
    "description": "开发任务→Agent/人工执行→证据汇总→Gate 审核→归档（任务书 §8 第一批模板③；执行完成确认采用人工审批收口——宿主执行通道开放前不自动触发执行；证据只挂候选，采纳唯一入口=真人提交闸）。",
    "dag": {
      "nodes": [
        {
          "key": "task_review",
          "type": "human_approval",
          "depends_on": [],
          "capability": "workbench.write",
          "expires_minutes": 60
        },
        {
          "key": "execute",
          "type": "human_approval",
          "depends_on": ["task_review"],
          "capability": "workbench.write",
          "expires_minutes": 1440
        },
        {
          "key": "collect_evidence",
          "type": "skill",
          "ref": "document-production@1",
          "depends_on": ["execute"],
          "output": "evidence_brief",
          "max_retries": 1,
          "timeout_seconds": 1800,
          "failure_class": "retryable",
          "input_schema": { "type": "object" },
          "output_schema": { "type": "object" },
          "params": {
            "project_id": "{{project_id}}",
            "objective": "汇总测试与执行产物，整理证据清单（只存指针与 sha256 指纹，证据原件留在项目工作目录）；候选挂接后仍需人工经提交闸采纳。"
          }
        },
        {
          "key": "gate_review",
          "type": "human_approval",
          "depends_on": ["collect_evidence"],
          "capability": "workbench.write",
          "expires_minutes": 1440
        }
      ]
    }
  }
]
