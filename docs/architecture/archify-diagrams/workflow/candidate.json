  "cards": [
    {
      "dot": "cyan",
      "title": "门禁与证据纪律",
      "items": [
        "G1–G9 按 seeds/gates.json 首次访问懒实例化，九门齐建",
        "证据只收 source_uri 指针 + sha256 指纹，同步登记一等证据表 project_evidence（同指纹幂等）；任务/工作流产物另挂建议性候选，采纳唯一入口=人工提交闸",
        "拍板人 ≠ 提交人（P0-5 gate_decider_conflict）；conditional_pass 仅限 G9 上线门；拍板带 expected_revision CAS（revision 冲突 409 如实呈现并刷新面板）"
      ]
    },
    {
      "dot": "rose",
      "title": "终审 signoff 唯一幂等开闸",
      "items": [
        "ensure_pending_signoff 是唯一开闸入口：同方案至多一个 pending，绝不重复开闸",
        "三个开闸来源：_finalize 非降级 completed 自动开；export_sow 拦下兜底开（先提交再 409，remedy=resolve_pending_signoff）；handoff 人工接管后开",
        "L1 降级产物永不自动进终审（linked_solution_id=None），handoff 后人工收口"
      ]
    },
    {
      "dot": "emerald",
      "title": "回款结算链",
      "items": [
        "收款实收回填钩子：update_payment 事务内为已发布/接单交付包落 settlement draft（基数=实收）",
        "G8 过门联动 mark_acceptance_passed：实收+验收双满足 → accrued 并计提预扣；G8 stop 尾款照收",
        "对应里程碑发票登记前置才可 payable；打款 paid 只存 paid_proof_source_uri 指针"
      ]
    },
    {
      "dot": "violet",
      "title": "交付方案与结项封包（V3.1 / T-B1）",
      "items": [
        "plans 生成器确定性拼装 accepted 需求 + needs_clarification 聚合风险条目；审查人流程与发布双闸，同一时刻至多一个 published（旧版自动 superseded）",
        "任务分解走既有 create_project_task（不指派=待认领），幂等重放 created=0；workflows 提供 draft-from-plan 草稿 + validate 干跑",
        "handover 封包逐项四闸（存在/本项目/已复核/指纹一致）+ manifest 规范化哈希复算；deliver 仅 admin、终态不可逆",
        "访谈转写只入草稿区（不可引用、T+7 自动清理），客户确认后晋升纪要才进正式库"
      ]
    }
  ]
}
