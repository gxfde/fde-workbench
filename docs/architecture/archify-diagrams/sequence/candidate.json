  "cards": [
    {
      "dot": "emerald",
      "title": "① 发起闸门（workflows/executor.py::start_run）",
      "items": [
        "幂等键全局唯一：同键同项目返回既有 run（created=false），跨项目同键 409 idempotency_conflict",
        "只接受 published 定义；未知节点类型 422 unsupported_node_type——不留必死 run",
        "run 起始状态为 queued；paused 只存在于 CHECK 值域，执行器永不写入",
        "同事务落库：workflow_runs(queued) + 每个节点一行 workflow_node_runs(pending)"
      ]
    },
    {
      "dot": "cyan",
      "title": "② 入队与调度（jobs/outbox.py + jobs/worker.py）",
      "items": [
        "事务性 outbox：workflow.run 事件与业务写同事务提交，业务回滚事件一并消失",
        "dispatch_pending 把它变成 background_jobs 行；ensure_background_job 单活守卫防重复投递",
        "worker 先提交认领（running + locked_until 租约）再跑 handler，handler 内不持长事务",
        "可重试类型失败自动退避重投（30s 起步 ×2 封顶 900s），outbox 保持 dispatched；耗尽才终失败"
      ]
    },
    {
      "dot": "violet",
      "title": "④⑤⑥ call / skill / agent 三条服务分派",
      "items": [
        "call：execute_api 同一闸，权限每节点实时校验（发起人 AI 档位 ∩ 项目 scope），run 级不冻结",
        "写类 call 节点强制落节点级 sha256 幂等键（与 api_actions 同构），跨重试/恢复不二次外呼",
        "skill：published 版本 instructions 作 system_prompt 的确定性调用，use_tools=False；计数走独立微事务，计数失败仅告警不炸节点",
        "agent：agents.start_run 同闸全链（鉴权/预算/试点/T1/T2/沙箱/产物校验），幂等键 wfnode-{行id}:{attempt}；宿主执行通道已接线，enabled=False 默认关闭"
      ]
    },
    {
      "dot": "amber",
      "title": "⑦⑧ human_approval 与人工拍板",
      "items": [
        "human_approval 复用 automation_approvals：run_id 置空 + workflow_node_run_id 反链",
        "request_key = wfnode:{节点行id}；arguments sha256 指纹 + 敏感键扫描 + 64KB 上限 + risk_level=4",
        "审批期间节点 waiting、run = waiting_approval（事件 workflow_run_waiting_approval）",
        "拍板走既有任务中心 decide_automation_approval：批准 → 节点 succeeded 并重投（hops+1 继承）；拒绝/过期 → 节点 failed"
      ]
    },
    {
      "dot": "rose",
      "title": "⑨⑩ 终态、取消与恢复",
      "items": [
        "断链不静默 done：出现 failed 节点 → run failed，下游 skipped（FV-F1 执行侧）",
        "节点成功同事务挂门禁证据候选（产物自带 gate_evidence 四元组才挂，平台不派生指纹）",
        "POST …/cancel 幂等：重复取消 200 cancelled=false；终态 409 already_terminal；取消后在途分派返回不静默丢弃（落 cancelled_after_dispatch 标记）",
        "POST …/resume 仅 failed：重投 hops+1 继承，超 MAX_RUN_HOPS=8 → 409 hops_exceeded；其余 409 not_resumable"
      ]
    }
  ]
}
