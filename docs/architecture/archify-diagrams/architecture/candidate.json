  "cards": [
    {
      "dot": "cyan",
      "title": "服务端业务域 (fde_api 单体 · 49 蓝图)",
      "items": [
        "项目交付: 门禁 G1–G9 · 报价/收款/合同/任务 · 产物候选与换版徽标",
        "售前主线: 调研 discovery · 交付方案 plans · 测试证据 quality · 结项封包 handover",
        "派单 dispatch · 工作流 workflows(三套种子模板+draft-from-plan) · 本体 ontology · 一等证据 evidence",
        "访谈转写 transcripts(草稿区 T+7 清理) · 模拟训练场 simulation · 到期只读投影 expirations"
      ]
    },
    {
      "dot": "emerald",
      "title": "异步任务链",
      "items": [
        "业务事务内写 outbox_events, worker 认领后经 Redis fde-jobs 派发",
        "无 Celery: 自研 Redis list 队列 + 租约续期 + 无主作业对账",
        "可重试类型失败自动退避重投(30s 起步 ×2 封顶 900s), outbox 全程保持 dispatched",
        "worker/scheduler 心跳键 TTL 驱动容器 healthcheck"
      ]
    },
    {
      "dot": "amber",
      "title": "Agent 与沙箱",
      "items": [
        "agents: run 生命周期 · T1/T2 评审门 · signoff 幂等开闸 · 配额",
        "agents/sandbox.py 经 docker CLI 拉起一次性容器 (--network none)",
        "宿主执行通道 execution_policy+HMAC 票据已接线, enabled=False 默认关闭(开启=拍板项)",
        "compose profile sandbox 基座, 默认不启动"
      ]
    },
    {
      "dot": "rose",
      "title": "安全与数据边界",
      "items": [
        "API 仅绑 127.0.0.1:8010, 桌面端 Bearer JWT (HS256)",
        "登录限流 fail-closed; MCP 工具令牌 aud=fde-mcp; 跨域到期投影 admin-only",
        "API confirmation 15 分钟窗口派生判定(恰等于即过期, 防重放优先于到期)",
        "客户原件只留本地工作目录, 仓库/库只存 source_uri + sha256"
      ]
    }
  ]
