{
  "name": "fde-workbench",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "desktop"
  ],
  "scripts": {
    "dev": "npm --workspace desktop run dev",
    "build:web": "npm --workspace desktop run build:web",
    "test": "npm run test:operations && npm run test:desktop && npm run test:server",
    "test:operations": "node --test tests/operations/*.test.mjs",
    "test:desktop": "npm --workspace desktop test",
    "test:server": "node scripts/run-server-tests.mjs",
    "typecheck": "npm --workspace desktop run typecheck",
    "package:mac": "npm --workspace desktop run package:mac",
    "package:win": "npm --workspace desktop run package:win",
    "verify:mac": "bash scripts/verify-dmg.sh"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron@43.4.1": true
  }
}
