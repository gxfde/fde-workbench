{
  "name": "@fde-workbench/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "FDE 项目工作台桌面客户端",
  "author": "FDE Workbench Contributors",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "icon:mac": "bash scripts/generate-icon.sh",
    "package:mac": "npm run build && npm run icon:mac && electron-builder --mac dmg --arm64",
    "package:win": "npm run build && electron-builder --win nsis --x64",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@swc/core": "1.13.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "26.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "org.fdeworkbench.desktop",
    "productName": "FDE 工作台",
    "artifactName": "FDE-Workbench-${version}-${arch}.${ext}",
    "asar": true,
    "files": [
      "out/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "../release"
    },
    "extraMetadata": {
      "fdeApiUrl": "http://127.0.0.1:8010"
    },
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "13.0.0",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "dmg": {
      "title": "FDE 工作台 ${version}",
      "contents": [
        {
          "x": 150,
          "y": 180
        },
        {
          "x": 430,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "mermaid": "11.17.2",
    "docx-preview": "^0.4.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
